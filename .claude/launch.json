{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mog-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
    },
    {
      "name": "mog-static-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8767", "--bind", "127.0.0.1"],
      "port": 8767,
      "autoPort": false
    },
    {
      "name": "mog-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tests/preview_server.js", "--port", "8770"],
      "port": 8770,
      "autoPort": false,
      "url": "http://127.0.0.1:8770"
    },
    {
      "name": "mog-preview-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tests/preview_server.js", "--port", "8771"],
      "port": 8771,
      "autoPort": false,
      "url": "http://127.0.0.1:8771"
    }
  ]
}
